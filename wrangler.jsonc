{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kao-nigero",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kao-nigero",
      "database_id": "2841766d-0d63-48ad-b40f-23ad1a9a3ded"
    }
  ]
}
